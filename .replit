modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "smoke-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ui-smoke"

[[workflows.workflow]]
name = "smoke-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/api-server/smoke_test.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ui-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/tests test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 20658
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ANTHROPIC_MODEL = "claude-haiku-4-5-20251001"
EXTRACTION_PROVIDER = "anthropic"
ANTHROPIC_TIMEOUT_MS = "60000"

[userenv.development]
NODE_ENV = "development"

[userenv.production]
NODE_ENV = "production"

[objectStorage]
defaultBucketID = "replit-objstore-c383de07-4677-4012-b3ed-44c5ca1b86fa"
